HOST=127.0.0.1
PORT=43123
# lichess uses the public cloud evaluation and needs no key. uci uses a local Stockfish binary.
ENGINE_PROVIDER=lichess
STOCKFISH_PATH=
STOCKFISH_DEFAULT_DEPTH=12
STOCKFISH_MAX_DEPTH=16
STOCKFISH_MOVETIME_MS=1200
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Exact tag from `ollama list`. qwen2.5:14b is the Ollama library name for Qwen 2.5 14B.
# If this name is not in Ollama's /api/tags, Talkfish does not call a model.
OLLAMA_MODEL=qwen2.5:14b
# The 14B model can take about 100 seconds to load on the first reply.
LLM_TIMEOUT_MS=180000
# Optional advanced provider. Not required for local use.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
APP_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
DATA_DIR=./data
CORPUS_DIR=./corpus
REPUTATION_MIN_DISTINCT=3
